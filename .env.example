# Parachute Vault — read-only token for Boulder vault
VAULT_TOKEN=pvt_your_read_only_token_here

# Base URL of your Parachute vault (no trailing slash, no /mcp suffix)
VAULT_URL=https://parachute.taildf9ce2.ts.net/vault/boulder
# Note: the build script appends /api to this URL for all requests

# Site base path — use / for root domain, /repo-name/ for GitHub Pages project sites
SITE_BASE=/
# Use / only if serving from a root domain (e.g. civics.example.com)
