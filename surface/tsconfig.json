{
  "compilerOptions": {
    // Mirrors the surface-server kit's own tsconfig: this package ships TS
    // source that runs under Bun inside the surface-host daemon, and the
    // kit (npm, raw-TS publish) resolves to TS source (`module: src/index.ts`),
    // so the bundler-mode + .ts-extension settings must match the kit's.
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["server", "scripts"],
  "exclude": ["node_modules"]
}
