{
  "name": "woven-boulder-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Woven Boulder frontend — a Vite SPA over the surface's 9 projection REST endpoints (anon, no tokens). Builds into ../dist, which surface-host serves at the mount root.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dompurify": "^3.2.4",
    "marked": "^12.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
