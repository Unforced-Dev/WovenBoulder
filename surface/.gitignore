# The workspace-root .gitignore ignores `dist/` (the static site's build
# output). This surface package's dist/ is its SHIPPED bundle (surface-host
# requires dist/index.html to register the surface) — unignore it here.
!dist/

# Release-packaging staging + artifacts (.github/workflows/release-surface.yml).
# Scoped so vendor/*.tgz (the tracked kit pins) stays unaffected.
/.pack/
/woven-boulder-surface-*.tgz
